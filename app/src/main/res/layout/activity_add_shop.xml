<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:id="@+id/main"
    tools:context=".activities.AddShopActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Let’s Set Up Your Shop"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="@dimen/_20sdp"
                android:textSize="@dimen/_18ssp"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/blackScreen" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add your shop details to get customers online"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/_10ssp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/greyScreen" />

            <!-- Banner Upload -->
            <!--<TextView
                android:id="@+id/shopBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to upload shop banner"
                android:padding="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:gravity="center_horizontal"
                android:elevation="@dimen/_2sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/greyScreen"
                android:background="@drawable/bg_edittext"
                android:drawablePadding="@dimen/_20sdp"
                app:drawableTopCompat="@drawable/baseline_photo_camera_24" />-->


            <ImageView
                android:id="@+id/shopImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_180sdp"
                android:padding="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:gravity="center"
                android:elevation="@dimen/_2sdp"
                android:background="@drawable/bg_edittext"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_photo_camera_24" />


            <!-- Shop Name -->
            <EditText
                android:id="@+id/shopName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:hint="Shop Name"
                android:layout_marginTop="@dimen/_20sdp"
                android:elevation="@dimen/_2sdp"
                android:fontFamily="@font/inter"
                android:textSize="@dimen/_12ssp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/dark_grey"
                android:background="@drawable/bg_edittext" />

            <Spinner
                android:id="@+id/spinnerMealType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_edittext"
                android:paddingStart="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                />

            <!-- Next Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/proceed_to_next_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginHorizontal="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:backgroundTint="@color/blue"
                android:fontFamily="@font/roboto"
                android:paddingTop="@dimen/_4sdp"
                android:text="Next Step"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/_8sdp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
