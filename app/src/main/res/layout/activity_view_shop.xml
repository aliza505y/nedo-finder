<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".activities.ViewShopActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_12sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="Shop Details"
            android:textColor="@color/blackScreen"
            android:textSize="@dimen/_18ssp" />

        <ImageButton
            android:id="@+id/fvShopBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="Shop Details"
            android:src="@drawable/outline_favorite_24"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginStart="@dimen/_130sdp"
            android:layout_gravity="center"/>


    </LinearLayout>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_8sdp"
                app:cardCornerRadius="@dimen/_4sdp"
                app:cardElevation="@dimen/_2sdp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/view_Shop_store"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_170sdp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/store_1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:drawableStart="@drawable/baseline_star_outline_24"
                        android:src="@drawable/star_rate"
                        android:text="4.5"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/view_Shop_store"
                        app:layout_constraintTop_toBottomOf="@+id/view_Shop_store" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/view_shop_profile_image"
                        android:layout_width="@dimen/_45sdp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_margin="@dimen/_8sdp"
                        android:src="@drawable/profile_7"
                        app:civ_border_color="@color/white"
                        app:civ_border_width="@dimen/_1sdp"
                        app:layout_constraintStart_toStartOf="@+id/view_Shop_store"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/view_shop_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/roboto_medium"
                        android:maxLines="1"
                        android:text="Hadi Kiryana store"
                        android:textColor="@color/blackScreen"
                        android:textSize="@dimen/_14ssp"
                        app:layout_constraintStart_toStartOf="@id/view_shop_profile_image"
                        app:layout_constraintTop_toBottomOf="@+id/view_Shop_store" />

                    <TextView
                        android:id="@+id/all_store_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:text="Grocery,Daily Need"
                        android:textColor="@color/greyScreen"
                        app:layout_constraintStart_toStartOf="@+id/view_shop_name"
                        app:layout_constraintTop_toBottomOf="@+id/view_shop_name" />


                    <TextView
                        android:id="@+id/shop_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_4sdp"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/poppins"
                        android:maxLines="2"
                        android:paddingVertical="@dimen/_8sdp"
                        android:text="Kiryana store have all the necessary products of your daily needs in reasonable prices."
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/all_store_category"
                        app:layout_constraintTop_toBottomOf="@+id/all_store_category" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/poppins_bold"
                android:text="Owner  Info"
                android:textColor="@color/blackScreen"
                android:textSize="@dimen/_12ssp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_8sdp"
                app:cardCornerRadius="@dimen/_4sdp"
                app:cardElevation="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_4sdp">

                    <TextView
                        android:id="@+id/owner_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:drawableStart="@drawable/user_shop"
                        android:drawablePadding="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:text="Malik Abdul Hadi Awan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/grey1" />

                    <TextView
                        android:id="@+id/contact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:drawableStart="@drawable/call_shop"
                        android:drawablePadding="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:text="03267948460" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/grey1" />

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:drawableStart="@drawable/location_shop"
                        android:drawablePadding="@dimen/_10sdp"
                        android:fontFamily="@font/poppins"
                        android:maxLines="2"
                        android:text="123 Main Road, Near Bus Stand, Block A City Bahawalpur"
                         />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:backgroundTint="@color/blue"
                android:fontFamily="@font/roboto"
                android:paddingTop="@dimen/_4sdp"
                android:text="Call for service"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/_8sdp" />


        </LinearLayout>
    </ScrollView>

</LinearLayout>